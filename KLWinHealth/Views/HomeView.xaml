<UserControl x:Class="KLWinHealth.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + live stats -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" FontSize="34" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Effect" Value="{StaticResource TextGlow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThreats}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThreats}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <c:StatCard Title="RAM" Icon="Memory" Value="{Binding RamText}" Subtitle="{Binding RamSub}" Percent="{Binding RamPercent}" />
                <c:StatCard Title="CPU" Icon="Chip" Value="{Binding CpuText}" Percent="{Binding CpuPercent}" Margin="10,0,0,0" Subtitle="All cores" />
                <c:StatCard Title="THREATS" Icon="ShieldAlertOutline" Value="{Binding Threats}" Subtitle="{Binding ThreatsSub}" Margin="10,0,0,0">
                    <c:StatCard.Style>
                        <Style TargetType="c:StatCard" BasedOn="{StaticResource {x:Type c:StatCard}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasThreats}" Value="True">
                                    <Setter Property="ValueBrush" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:StatCard.Style>
                </c:StatCard>
                <c:StatCard Title="FREE (C:)" Icon="Harddisk" Value="{Binding DiskText}" Subtitle="{Binding DiskSub}" Percent="{Binding DiskUsedPercent}" Margin="10,0,0,0" Width="138" />
            </StackPanel>
        </Grid>

        <!-- 4x2 tiles -->
        <UniformGrid x:Name="Tiles" Grid.Row="1" Columns="4" Rows="2" Margin="-7,26,-7,0" VerticalAlignment="Top">
            <UniformGrid.Resources>
                <Style TargetType="c:ClippedTile" BasedOn="{StaticResource {x:Type c:ClippedTile}}">
                    <Setter Property="Margin" Value="7" />
                    <Setter Property="Height" Value="104" />
                    <Setter Property="Command" Value="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Style>
            </UniformGrid.Resources>
            <c:ClippedTile Label="Virus check" SubLabel="Defender · heuristics · VirusTotal" Icon="ShieldCheck" CommandParameter="Virus" />
            <c:ClippedTile Label="Clean ROG service" SubLabel="ASUS / Armoury Crate services" Icon="GamepadVariant" CommandParameter="Rog" />
            <c:ClippedTile Label="Clean Windows service" SubLabel="Stop what you don't need" Icon="MicrosoftWindows" CommandParameter="Windows" />
            <c:ClippedTile Label="Browser cleaner" SubLabel="Processes · settings · cache" Icon="Web" CommandParameter="Browser" />
            <c:ClippedTile Label="Clean storage" SubLabel="Temp files · large files" Icon="Broom" CommandParameter="Storage" />
            <c:ClippedTile Label="Wallpaper" SubLabel="Desktop · slideshow · lock screen" Icon="ImageOutline" CommandParameter="Wallpaper" />
            <c:ClippedTile Label="Desktop widgets" SubLabel="Clock · monitor · calendar" Icon="ViewDashboard" CommandParameter="Widgets" />
            <c:ClippedTile Label="Settings" SubLabel="Startup · restore · about" Icon="Cog" CommandParameter="Settings" />
        </UniformGrid>
    </Grid>
</UserControl>
