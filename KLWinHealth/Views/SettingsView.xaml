<UserControl x:Class="KLWinHealth.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:PageHeader Title="Settings" Subtitle="Startup, VirusTotal, auto-clean and restore" Icon="Cog" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- General -->
                    <c:AngledBorder Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Starts in the tray at sign-in so desktop widgets come back after a restart. No UAC prompt." Style="{StaticResource Muted}" FontSize="11.5" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Minimize to tray on close" />
                                    <TextBlock Text="Closing the window keeps widgets and the slideshow running." Style="{StaticResource Muted}" FontSize="11.5" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </c:AngledBorder>

                    <!-- VirusTotal -->
                    <c:AngledBorder Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="VIRUSTOTAL API KEY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Style="{StaticResource Muted}">
                                Optional. Lets Virus check look up file hashes on VirusTotal (free tier: 4 lookups/minute).
                                The key is encrypted with Windows DPAPI.
                                <Hyperlink Command="{Binding OpenVirusTotalSiteCommand}">Get a free key</Hyperlink>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasVirusTotalKey, Converter={StaticResource BoolToVis}}">
                                <iconPacks:PackIconMaterial Kind="KeyVariant" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Key saved (encrypted)" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <Button Content="Remove" Margin="14,0,0,0" Padding="10,4" Command="{Binding RemoveVirusTotalKeyCommand}" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="VtKey" />
                                <Button Grid.Column="1" Content="Save key" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveVirusTotalKeyCommand}" CommandParameter="{Binding ElementName=VtKey}" />
                            </Grid>
                        </StackPanel>
                    </c:AngledBorder>

                    <!-- Auto clean -->
                    <c:AngledBorder Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="WEEKLY AUTO-CLEAN" Style="{StaticResource SectionLabel}" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoCleanEnabled}" Content="Clean Safe storage categories weekly" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding AutoCleanEnabled}">
                                <TextBlock Text="Day" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding Days}" SelectedItem="{Binding AutoCleanDay}" />
                                <TextBlock Text="Time" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox Width="70" Margin="8,0,0,0" Text="{Binding AutoCleanTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="24-hour time, e.g. 12:30" />
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="{Binding AutoCleanStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Button Content="Apply" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAutoCleanCommand}" />
                            </Grid>
                        </StackPanel>
                    </c:AngledBorder>

                    <!-- Folders + about -->
                    <c:AngledBorder Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" />
                            <WrapPanel>
                                <c:GlowButton Icon="TextBoxOutline" Content="Logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                                <c:GlowButton Icon="Biohazard" Content="Quarantine" Command="{Binding OpenQuarantineCommand}" Margin="0,0,8,8" />
                                <c:GlowButton Icon="BackupRestore" Content="Backups" Command="{Binding OpenBackupsCommand}" Margin="0,0,8,8" />
                                <c:GlowButton Icon="FileCogOutline" Content="Config lists" Command="{Binding OpenConfigCommand}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" Margin="0,8,0,6" />
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentBrush}">
                                <Run Text="{Binding AppName, Mode=OneWay}" /> <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Text="Running as administrator" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Not running as administrator — services, policies and system folders can't be changed."
                                       Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </c:AngledBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- Restore everything -->
            <c:AngledBorder Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESTORE EVERYTHING" Style="{StaticResource SectionLabel}" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,160,0"
                                   Text="Every change to a service, policy/registry value or wallpaper is backed up first. Restore one backup, or put everything back to its original state." />
                        <CheckBox Content="Hide restored" IsChecked="{Binding HideRestored}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding BackupRecords}" SelectedItem="{Binding SelectedBackup}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="140" />
                            <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="110" />
                            <DataGridTemplateColumn Header="Change" Width="*" SortMemberPath="Description">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CellText}" ToolTip="{Binding Description}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="No backups yet — nothing has been changed." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding BackupRecords.Count, Converter={StaticResource ZeroToVis}}" />
                    <ItemsControl Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding SelectedBackup.Entries}" MaxHeight="90">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <c:GlowButton Icon="Refresh" Content="Refresh" Command="{Binding RefreshBackupsCommand}" />
                        <c:GlowButton Icon="Restore" Content="Restore selected" Margin="8,0,0,0" Command="{Binding RestoreSelectedCommand}" />
                        <c:GlowButton Icon="BackupRestore" Content="Restore everything" Margin="8,0,0,0" Variant="Danger" Command="{Binding RestoreAllCommand}" />
                    </StackPanel>
                </Grid>
            </c:AngledBorder>
        </Grid>

        <c:BusyBar Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Busy}" />
    </Grid>
</UserControl>
