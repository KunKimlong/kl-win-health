<Window x:Class="KLWinHealth.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:KLWinHealth.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="Height" Width="500" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}" Title="KL Win Health"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <c:AngledBorder CutSize="14" BorderThickness="1.5" BorderBrush="{StaticResource AccentDarkBrush}"
                        Background="{StaticResource TitleBarBrush}" x:Name="Frame">
            <c:AngledBorder.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
            </c:AngledBorder.Effect>
            <StackPanel Margin="22,18,22,18">
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnDragTitle" Background="Transparent">
                    <iconPacks:PackIconMaterial x:Name="HeaderIcon" Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center"
                                                Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" Style="{StaticResource H2}" FontSize="21" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" />
                <Border x:Name="DetailsHost" Margin="0,12,0,0" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <ItemsControl x:Name="DetailsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="WarningText" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Content="OK" MinWidth="96" Margin="10,0,0,0" Click="OnOk" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </StackPanel>
        </c:AngledBorder>
    </Grid>
</Window>
