<UserControl x:Class="KLWinHealth.Views.WidgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:w="clr-namespace:KLWinHealth.Views.Widgets"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <!-- Colour swatch row: Tag = command -->
        <DataTemplate x:Key="SwatchTemplate">
            <Button Width="20" Height="20" Margin="0,0,5,0" Cursor="Hand" ToolTip="{Binding}"
                    Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{Binding}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="B" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Icon="WidgetsOutline">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Chip}" GroupName="wm" IsChecked="{Binding IsLocked, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CursorMove" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Edit mode" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="wm" IsChecked="{Binding IsLocked}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Lock" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Locked" />
                    </StackPanel>
                </RadioButton>
                <c:GlowButton Icon="Pin" Content="Re-attach" Margin="4,0,0,0" Command="{Binding ReattachCommand}"
                              ToolTip="Put all widgets back on the desktop layer (if Explorer restarted)" />
            </StackPanel>
        </c:PageHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================ add + list -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="ADD WIDGET" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Types}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:GlowButton Icon="{Binding Icon}" Content="{Binding Name}" Margin="0,0,6,6" HorizontalContentAlignment="Left" ToolTip="{Binding Description}"
                                          Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ON YOUR DESKTOP" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Widgets}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="No widgets yet — add one above." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Widgets.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox Content="Snap to grid while dragging" IsChecked="{Binding SnapToGrid}" />
                    <StackPanel Orientation="Horizontal" Margin="26,6,0,0" IsEnabled="{Binding SnapToGrid}">
                        <TextBlock Text="Grid size" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        <Slider Width="120" Minimum="4" Maximum="50" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding GridSize}" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GridSize, StringFormat={}{0} px}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ================================================ editor -->
            <c:AngledBorder Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Add a widget or select one to edit it." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="170" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Live preview on a wallpaper-like backdrop -->
                        <Border Margin="1,1,1,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF173A2A" Offset="0" />
                                    <GradientStop Color="#FF0A1410" Offset="0.6" />
                                    <GradientStop Color="#FF1B2B48" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox StretchDirection="DownOnly" Margin="12">
                                <w:WidgetContent DataContext="{Binding SelectedModel}" />
                            </Viewbox>
                        </Border>
                        <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" Margin="12,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.7" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,8">
                            <Grid DataContext="{Binding Selected}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: content + type options -->
                                <StackPanel>
                                    <!-- Text -->
                                    <StackPanel Visibility="{Binding Type, Converter={StaticResource EqualsConv}, ConverterParameter=Text}">
                                        <TextBlock Text="Text" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    </StackPanel>
                                    <!-- Clock -->
                                    <StackPanel Visibility="{Binding Type, Converter={StaticResource EqualsConv}, ConverterParameter=Clock}">
                                        <TextBlock Text="Clock" Style="{StaticResource FieldLabel}" />
                                        <CheckBox Content="24-hour time" IsChecked="{Binding Use24Hour}" />
                                        <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds}" Margin="0,6,0,0" />
                                        <CheckBox Content="Show date" IsChecked="{Binding ShowDate}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <!-- System monitor -->
                                    <StackPanel Visibility="{Binding Type, Converter={StaticResource EqualsConv}, ConverterParameter=SystemMonitor}">
                                        <TextBlock Text="Show" Style="{StaticResource FieldLabel}" />
                                        <UniformGrid Columns="2">
                                            <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" Margin="0,0,0,6" />
                                            <CheckBox Content="RAM" IsChecked="{Binding ShowRam}" Margin="0,0,0,6" />
                                            <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}" />
                                            <CheckBox Content="Disk activity" IsChecked="{Binding ShowDisk}" />
                                        </UniformGrid>
                                        <TextBlock Text="Display" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding DataContext.MonitorDisplays, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding MonitorDisplay}" />
                                    </StackPanel>

                                    <TextBlock Text="Font" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.Fonts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding FontFamily}">
                                        <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Font size " /><Run Text="{Binding FontSize, Mode=OneWay, StringFormat={}{0:0}}" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                                    <Slider Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" />
                                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Size " /><Run Text="{Binding Scale, Mode=OneWay, StringFormat={}{0:0.00}×}" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                                    <Slider Minimum="0.5" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Scale}" />
                                    <TextBlock Text="Position (screen pixels)" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Width="80" Margin="6,0,14,0" Text="{Binding X, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="Y" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBox Width="80" Margin="6,0,0,0" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: colours + shape -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Text color" Style="{StaticResource FieldLabel}" />
                                    <ItemsControl ItemsSource="{Binding DataContext.Swatches, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Tag="{Binding DataContext.SetTextColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ItemTemplate="{StaticResource SwatchTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBox Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" Width="110" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" />

                                    <TextBlock Text="Background color" Style="{StaticResource FieldLabel}" />
                                    <ItemsControl ItemsSource="{Binding DataContext.Swatches, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Tag="{Binding DataContext.SetBackgroundColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ItemTemplate="{StaticResource SwatchTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" Width="110" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" />

                                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Background opacity " /><Run Text="{Binding BackgroundOpacity, Mode=OneWay, StringFormat={}{0}%}" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}" />

                                    <TextBlock Text="Corners" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding DataContext.CornerStyles, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Corner}" />
                                    <CheckBox Content="Text shadow (readable on any wallpaper)" IsChecked="{Binding TextShadow}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <c:GlowButton Icon="ArrowCollapseAll" Content="Reset size" Command="{Binding ResetScaleCommand}" />
                                <c:GlowButton Icon="ContentCopy" Content="Duplicate" Margin="8,0,0,0" Command="{Binding DuplicateCommand}" />
                                <c:GlowButton Icon="DeleteOutline" Content="Remove" Variant="Danger" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </c:AngledBorder>
        </Grid>
    </Grid>
</UserControl>
