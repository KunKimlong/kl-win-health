<UserControl x:Class="KLWinHealth.Views.BrowserCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Icon="Web">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="190" ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser}" DisplayMemberPath="Name"
                          ToolTip="Browser shown on the Processes and Extensions tabs" />
                <c:GlowButton Icon="Refresh" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                <c:GlowButton Icon="BackupRestore" Content="Restore" Margin="8,0,0,0" Command="{Binding RestoreModuleCommand}"
                              ToolTip="Put every browser setting changed by KL Win Health back to its original value" />
            </StackPanel>
        </c:PageHeader>

        <TextBlock Grid.Row="1" Text="No supported browser found (Chrome, Edge, Brave, Firefox)." Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding NoBrowsers, Converter={StaticResource BoolToVis}}" />

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}"
                    Visibility="{Binding NoBrowsers, Converter={StaticResource InverseBoolToVis}}">
            <!-- ============================================================ PROCESSES -->
            <TabItem Header="Processes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ProcessSummary}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontFamily="{StaticResource HeadingFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Auto refresh" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <c:GlowButton Icon="KeyboardOutline" Content="Shift+Esc tip" Command="{Binding OpenBrowserTaskManagerTipCommand}"
                                          ToolTip="Use the browser's own Task Manager to close one tab or extension" />
                            <c:GlowButton Icon="WindowClose" Content="Close browser" Variant="Danger" Margin="8,0,0,0" Command="{Binding CloseBrowserCommand}"
                                          IsEnabled="{Binding IsBrowserRunning}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Process" Width="2*" SortMemberPath="Label">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Safety" Width="112" SortMemberPath="SafetyText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Tag="{Binding SafetyStatus}">
                                            <TextBlock Text="{Binding SafetyText}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding PrivateBytes, Converter={StaticResource Bytes}}" Width="90" SortMemberPath="PrivateBytes" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="64" SortMemberPath="CpuPercent" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="The browser is not running." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Processes.Count, Converter={StaticResource ZeroToVis}}" />

                    <c:AngledBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel Visibility="{Binding SelectedProcess, Converter={StaticResource InverseNullToVis}}">
                                <TextBlock Text="HOW TO READ THIS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                           Text="Chromium browsers split into many processes: one main process, one per tab group, plus GPU, network, audio and extension helpers. Only processes marked Safe to end can be ended here." />
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}"
                                           Text="To find which tab uses the most memory, press Shift+Esc inside Chrome, Edge or Brave (Firefox: about:processes)." />
                            </StackPanel>
                            <Grid Visibility="{Binding SelectedProcess, Converter={StaticResource NullToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding SelectedProcess}">
                                        <Border Style="{StaticResource Badge}" Tag="{Binding SafetyStatus}">
                                            <TextBlock Text="{Binding SafetyText}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource H3}" FontSize="17" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                        <TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                                        <TextBlock><Run Text="PID " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding Pid, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Margin="0,3,0,0"><Run Text="Private memory " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding PrivateBytes, Mode=OneWay, Converter={StaticResource Bytes}}" /></TextBlock>
                                        <TextBlock Margin="0,3,0,0"><Run Text="Working set " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding WorkingSet, Mode=OneWay, Converter={StaticResource Bytes}}" /></TextBlock>
                                        <TextBlock Text="COMMAND LINE" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                                        <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="10.5" />
                                    </StackPanel>
                                </ScrollViewer>
                                <c:GlowButton Grid.Row="1" Icon="Close" Content="End process" Variant="Danger" Margin="0,10,0,0"
                                              Command="{Binding EndProcessCommand}" CommandParameter="{Binding SelectedProcess}"
                                              ToolTip="Only processes marked Safe to end can be ended" />
                            </Grid>
                        </Grid>
                    </c:AngledBorder>
                </Grid>
            </TabItem>

            <!-- ============================================================ EXTENSIONS -->
            <TabItem Header="Installed extensions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding ExtensionSummary}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontFamily="{StaticResource HeadingFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                        <c:GlowButton HorizontalAlignment="Right" Icon="PuzzleOutline" Content="Open extensions page" Variant="Primary"
                                      Command="{Binding OpenExtensionsPageCommand}"
                                      ToolTip="Opens the browser's extensions page, where you can remove or turn off extensions" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Extensions}" SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Extension" Width="3*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="State" Width="96" SortMemberPath="EnabledText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Tag="{Binding EnabledStatus}">
                                            <TextBlock Text="{Binding EnabledText}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="80" SortMemberPath="Size" />
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Open folder"
                                                Command="{Binding DataContext.OpenExtensionFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No extensions found." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Extensions.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>
            </TabItem>

            <!-- ============================================================ POLICIES -->
            <TabItem Header="Optimize settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Memory-saving browser policies for all installed Chromium browsers." VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        <c:GlowButton HorizontalAlignment="Right" Icon="AutoFix" Content="Apply all recommended" Variant="Primary"
                                      Command="{Binding ApplyAllPoliciesCommand}" />
                    </Grid>
                    <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Visibility="{Binding IsManagedNoteVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12.5"
                                       Text="Your browser will show &quot;Managed by your organization&quot;. That's expected — it comes from these policies, and goes away when you click Restore." />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Policies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:AngledBorder Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding BrowserName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="0,0,12,0"
                                                    Tag="{Binding IsApplied, Converter={StaticResource OkNeutralStatus}}">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}" />
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:GlowButton Icon="Check" Content="Apply" Variant="Primary" MinWidth="90"
                                                              Command="{Binding DataContext.ApplyPolicyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"
                                                              Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVis}}" />
                                                <c:GlowButton Icon="Undo" Content="Undo" MinWidth="90"
                                                              Command="{Binding DataContext.UndoPolicyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"
                                                              Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </c:AngledBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="No Chromium browser installed — Firefox has no supported memory policies here." Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Policies.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>
            </TabItem>

            <!-- ============================================================ CACHE -->
            <TabItem Header="Clear cache">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CacheSummary}" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Only cache files are deleted. Cookies, passwords, history and bookmarks are kept. Browsers are closed first." Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <c:GlowButton Icon="Magnify" Content="Analyze" Command="{Binding AnalyzeCacheCommand}" />
                            <c:GlowButton Icon="Broom" Content="Clear selected" Variant="Primary" Margin="8,0,0,0" Command="{Binding ClearCacheCommand}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CacheEntries}" SelectionMode="Single" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Browser" Binding="{Binding BrowserName}" Width="140" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" />
                            <DataGridTextColumn Header="Cache" Binding="{Binding CacheSize, Converter={StaticResource Bytes}}" Width="90" SortMemberPath="CacheSize" />
                            <DataGridTextColumn Header="Code cache" Binding="{Binding CodeCacheSize, Converter={StaticResource Bytes}}" Width="96" SortMemberPath="CodeCacheSize" />
                            <DataGridTextColumn Header="GPU cache" Binding="{Binding GpuCacheSize, Converter={StaticResource Bytes}}" Width="90" SortMemberPath="GpuCacheSize" />
                            <DataGridTextColumn Header="Service worker" Binding="{Binding ServiceWorkerSize, Converter={StaticResource Bytes}}" Width="110" SortMemberPath="ServiceWorkerSize" />
                            <DataGridTemplateColumn Header="Total" Width="96" SortMemberPath="TotalSize">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalSize, Converter={StaticResource Bytes}}" Style="{StaticResource CellText}"
                                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <c:BusyBar Grid.Row="2" Margin="0,10,0,0" DataContext="{Binding Busy}" />
    </Grid>
</UserControl>
