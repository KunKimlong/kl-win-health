<UserControl x:Class="KLWinHealth.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- Shared by "Clean ROG service" and "Clean Windows service" (DataContext = ServicesPageViewModel) -->
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Icon="{Binding PageIcon}">
            <StackPanel Orientation="Horizontal">
                <c:GlowButton Icon="Refresh" Content="Refresh" Command="{Binding RefreshCommand}" />
                <c:GlowButton Icon="BackupRestore" Content="Restore" Margin="8,0,0,0" Command="{Binding RestoreModuleCommand}"
                              ToolTip="Put every service changed on this page back to its original state" />
                <c:GlowButton Icon="AutoFix" Content="Clean recommended" Variant="Primary" Margin="8,0,0,0" Command="{Binding CleanRecommendedCommand}"
                              ToolTip="Stop + disable only the services marked Safe (asks first)" />
            </StackPanel>
        </c:PageHeader>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" Content="All" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=Safe}">
                    <TextBlock><Run Text="Safe " /><Run Text="{Binding SafeCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=Caution}">
                    <TextBlock><Run Text="Caution " /><Run Text="{Binding CautionCount, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=Protected}">
                    <TextBlock><Run Text="{Binding ProtectedLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ProtectedCount, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=Other}">
                    <TextBlock><Run Text="{Binding OtherLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding OtherCount, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="sf" IsChecked="{Binding Filter, Converter={StaticResource EqualsConv}, ConverterParameter=Running}">
                    <TextBlock><Run Text="Running only " /><Run Text="{Binding RunningCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding RamFreedText}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource HeadingFont}" FontSize="16" />
                <TextBox Width="200" Tag="Search services…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" SelectionMode="Single" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Service" Width="3*" SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CellText}" FontWeight="SemiBold" ToolTip="{Binding Description}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Category" Width="128" SortMemberPath="CategoryText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}" Tag="{Binding CategoryStatus}" ToolTip="{Binding Reason}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Lock" Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                    Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource StatusBrush}}"
                                                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource BadgeText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="What it does" Width="2*" SortMemberPath="RuleLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource CellText}" Foreground="{StaticResource TextMutedBrush}" ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="82" SortMemberPath="StatusText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DisabledTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Startup" Binding="{Binding StartupText}" Width="150" />
                    <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" Width="80" SortMemberPath="RamBytes" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No services found." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}" />

            <!-- Detail panel -->
            <c:AngledBorder Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select a service to see details and actions." Style="{StaticResource Muted}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource InverseNullToVis}}" />
                    <Grid Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Selected}">
                                <Border Style="{StaticResource Badge}" Tag="{Binding CategoryStatus}">
                                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource BadgeText}" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H3}" FontSize="17" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                <TextBlock Text="{Binding RuleLabel}" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                           Visibility="{Binding RuleLabel, Converter={StaticResource NullToVis}}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Visibility="{Binding Reason, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"
                                           Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"
                                           Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Status" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" />
                                    <TextBlock Grid.Row="1" Text="Startup" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartupText}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="2" Text="RAM" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamText}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="3" Text="Publisher" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Publisher, TargetNullValue='—'}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="4" Text="Program" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExePath, TargetNullValue='—'}" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" />
                                </Grid>
                                <Border Margin="0,12,0,0" Padding="10,8" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Lock" Width="12" Height="12" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Locked — this service is never stopped by KL Win Health." Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
                            <c:GlowButton Icon="Stop" Content="Stop" Margin="0,0,4,6" Command="{Binding StopCommand}" CommandParameter="{Binding Selected}"
                                          IsEnabled="{Binding Selected.CanStop}" ToolTip="Stop the service now (it starts again at the next boot if startup is Automatic)" />
                            <c:GlowButton Icon="Cancel" Content="Disable" Variant="Danger" Margin="4,0,0,6" Command="{Binding DisableCommand}" CommandParameter="{Binding Selected}"
                                          IsEnabled="{Binding Selected.CanDisable}" ToolTip="Stop it and set startup to Disabled" />
                            <c:GlowButton Icon="HandBackRight" Content="Manual" Margin="0,0,4,0" Command="{Binding ManualCommand}" CommandParameter="{Binding Selected}"
                                          IsEnabled="{Binding Selected.CanSetManual}" ToolTip="Set startup to Manual (starts only when something needs it)" />
                            <c:GlowButton Icon="Restore" Content="Restore" Margin="4,0,0,0" Command="{Binding RestoreItemCommand}" CommandParameter="{Binding Selected}"
                                          IsEnabled="{Binding Selected.HasBackup}" />
                        </UniformGrid>
                    </Grid>
                </Grid>
            </c:AngledBorder>
        </Grid>

        <c:BusyBar Grid.Row="3" Margin="0,10,0,0" DataContext="{Binding Busy}" />
    </Grid>
</UserControl>
