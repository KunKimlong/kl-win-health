<UserControl x:Class="KLWinHealth.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <!-- Shared file grid columns for "Large files" and "Old downloads" -->
        <DataTemplate x:Key="FileCheckCell">
            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="FileNameCell">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" ToolTip="{Binding FullPath}" />
                <TextBlock Text="{Binding Folder}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" ToolTip="{Binding Folder}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileOpenCell">
            <Button Style="{StaticResource IconButton}" ToolTip="Show in Explorer"
                    Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Icon="Harddisk" />

        <!-- Drive bars -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:AngledBorder Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10" Width="340">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Harddisk" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding UsedPercent, StringFormat={}{0:0}% used}" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,6">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </c:AngledBorder>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
            <!-- ============================================================ CLEANUP -->
            <TabItem Header="Cleanup">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" FontSize="12"
                                       Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <c:GlowButton Icon="CheckboxMarkedOutline" Content="Safe only" Command="{Binding SelectSafeCommand}" ToolTip="Select only the Safe categories" />
                            <c:GlowButton Icon="CheckboxBlankOutline" Content="None" Margin="8,0,0,0" Command="{Binding SelectNoneCommand}" />
                            <c:GlowButton Icon="Magnify" Content="Analyze" Margin="8,0,0,0" Command="{Binding AnalyzeCommand}" />
                            <c:GlowButton Icon="Broom" Content="Clean selected" Variant="Primary" Margin="8,0,0,0" Command="{Binding CleanCommand}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" SelectionMode="Single" RowHeight="46"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  Visibility="{Binding IsShortcut, Converter={StaticResource InverseBoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Category" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       ToolTip="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Level" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Tag="{Binding Level}">
                                            <TextBlock Text="{Binding Level}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Found" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CellText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding Size, Converter={StaticResource Bytes}}"
                                                       Visibility="{Binding IsAnalyzed, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource CellText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Open folder" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.OpenCategoryFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsShortcut, Converter={StaticResource InverseBoolToVis}}">
                                                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" />
                                            </Button>
                                            <c:GlowButton Icon="Web" Content="Open" Padding="10,4"
                                                          Command="{Binding DataContext.OpenBrowserCleanerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================================================ LARGE FILES -->
            <TabItem Header="Large files">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding LargeFilesSummary}" VerticalAlignment="Center" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,560,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox Width="150" ItemsSource="{Binding Drives}" SelectedItem="{Binding LargeFilesDrive}" DisplayMemberPath="Title" />
                            <c:GlowButton Icon="Magnify" Content="Scan drive" Margin="8,0,0,0" Command="{Binding ScanLargeFilesCommand}" />
                            <c:GlowButton Icon="FolderSearchOutline" Content="Folder…" Margin="8,0,0,0" Command="{Binding BrowseLargeFilesFolderCommand}" />
                            <c:GlowButton Icon="DeleteOutline" Content="Recycle selected" Variant="Danger" Margin="8,0,0,0" Command="{Binding RecycleLargeFilesCommand}"
                                          ToolTip="Moves ticked files to the Recycle Bin (you can still restore them)" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LargeFiles}" SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource FileCheckCell}" />
                            <DataGridTemplateColumn Header="File" Width="*" CellTemplate="{StaticResource FileNameCell}" SortMemberPath="Name" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="100" SortMemberPath="Size" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                            <DataGridTemplateColumn Width="48" CellTemplate="{StaticResource FileOpenCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No scan yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding LargeFiles.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>
            </TabItem>

            <!-- ============================================================ OLD DOWNLOADS -->
            <TabItem Header="Old downloads">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,560,0">
                            <TextBlock Text="{Binding DownloadsFolder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DownloadsSummary}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Older than" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                            <ComboBox Width="90" ItemsSource="{Binding DownloadAgeOptions}" SelectedItem="{Binding DownloadAge}" ItemStringFormat="{}{0} days" />
                            <c:GlowButton Icon="Magnify" Content="Review" Margin="8,0,0,0" Command="{Binding ScanDownloadsCommand}" />
                            <c:GlowButton Icon="CheckAll" Content="Tick all" Margin="8,0,0,0" Command="{Binding CheckAllCommand}" CommandParameter="{Binding OldDownloads}" />
                            <c:GlowButton Icon="DeleteOutline" Content="Recycle selected" Variant="Danger" Margin="8,0,0,0" Command="{Binding RecycleDownloadsCommand}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OldDownloads}" SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource FileCheckCell}" />
                            <DataGridTemplateColumn Header="File" Width="*" CellTemplate="{StaticResource FileNameCell}" SortMemberPath="Name" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="100" SortMemberPath="Size" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="100" SortMemberPath="LastModified" />
                            <DataGridTemplateColumn Width="48" CellTemplate="{StaticResource FileOpenCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Click Review to list files you haven't touched in a while. Nothing is removed without your confirmation, and removed files go to the Recycle Bin."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                               Visibility="{Binding OldDownloads.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>
            </TabItem>
        </TabControl>

        <c:BusyBar Grid.Row="3" Margin="0,10,0,0" DataContext="{Binding Busy}" />
    </Grid>
</UserControl>
