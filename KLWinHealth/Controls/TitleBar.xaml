<UserControl x:Class="KLWinHealth.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Height="36" Background="{StaticResource TitleBarBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <!-- Text is set in code-behind with hair spaces between letters (WPF has no letter-spacing property) -->
            <TextBlock x:Name="AppTitle" Margin="10,1,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource AccentBrush}" Effect="{StaticResource TextGlow}" />
            <Border x:Name="LimitedBadge" Margin="12,0,0,0" Padding="7,1" VerticalAlignment="Center" BorderThickness="1"
                    BorderBrush="{StaticResource WarningBrush}" Background="{StaticResource WarningSoftBrush}" Visibility="Collapsed"
                    ToolTip="The app is not running as administrator, so services, policies and system folders can't be changed. Click to restart as administrator."
                    WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="OnRestartAsAdmin">
                <TextBlock Text="LIMITED MODE · RESTART AS ADMIN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize" ToolTip="Minimize">
                <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="12" Height="12" />
            </Button>
            <Button Style="{StaticResource TitleBarButton}" Click="OnMaximize" ToolTip="Maximize">
                <iconPacks:PackIconMaterial x:Name="MaxIcon" Kind="WindowMaximize" Width="12" Height="12" />
            </Button>
            <Button Style="{StaticResource TitleBarCloseButton}" Click="OnClose" ToolTip="Close">
                <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
