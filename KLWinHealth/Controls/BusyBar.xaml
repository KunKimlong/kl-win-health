<UserControl x:Class="KLWinHealth.Controls.BusyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KLWinHealth.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
    <!-- DataContext = BusyState -->
    <c:AngledBorder CutSize="8" BorderThickness="1" BorderBrush="{StaticResource AccentDarkBrush}" Background="{StaticResource TitleBarBrush}"
                    Padding="14,9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconMaterial Kind="Loading" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                                        RenderTransformOrigin="0.5,0.5">
                <iconPacks:PackIconMaterial.RenderTransform>
                    <RotateTransform x:Name="Spin" />
                </iconPacks:PackIconMaterial.RenderTransform>
                <iconPacks:PackIconMaterial.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </iconPacks:PackIconMaterial.Triggers>
            </iconPacks:PackIconMaterial>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                <ProgressBar Margin="0,6,0,0" Height="4" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" />
            </StackPanel>
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                    Padding="12,5" IsEnabled="{Binding CanCancel}" />
        </Grid>
    </c:AngledBorder>
</UserControl>
