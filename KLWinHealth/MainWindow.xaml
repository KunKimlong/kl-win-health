<Window x:Class="KLWinHealth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:KLWinHealth.Controls"
        xmlns:vm="clr-namespace:KLWinHealth.ViewModels"
        xmlns:v="clr-namespace:KLWinHealth.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="KL Win Health" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}" FontSize="13"
        BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Navigation.CurrentPage.GoBackCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Navigation.CurrentPage.GoBackCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- View model → view mapping -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VirusCheckViewModel}"><v:VirusCheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RogServicesViewModel}"><v:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsServicesViewModel}"><v:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserCleanerViewModel}"><v:BrowserCleanerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}"><v:StorageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WallpaperViewModel}"><v:WallpaperView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WidgetsViewModel}"><v:WidgetsView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:TitleBar />

        <c:AnimatedContentControl Grid.Row="1" Content="{Binding Navigation.CurrentPage}" Focusable="False" />

        <!-- Toast -->
        <c:AngledBorder Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                        CutSize="8" BorderThickness="1.5" Background="{StaticResource TitleBarBrush}" Padding="16,10" MaxWidth="640"
                        IsHitTestVisible="False" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <c:AngledBorder.Style>
                <Style TargetType="c:AngledBorder">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </c:AngledBorder.Style>
            <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" FontSize="13" />
        </c:AngledBorder>
    </Grid>
</Window>
