<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KLWinHealth</RootNamespace>
    <AssemblyName>KLWinHealth</AssemblyName>
    <Product>KL Win Health</Product>
    <AssemblyTitle>KL Win Health</AssemblyTitle>
    <Company>KL</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Single-file publish settings (used by build.bat) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <!-- Developer-only switch: dotnet build -p:KLNoElevate=true builds with an asInvoker manifest
       so the UI can be smoke-tested from a non-elevated shell (app runs in "limited mode"). -->
  <PropertyGroup Condition="'$(KLNoElevate)' == 'true'">
    <ApplicationManifest>app.asinvoker.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);KL_DEV_NOELEVATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
    <None Include="Assets\Fonts\OFL.txt" />
    <!-- Config lists are embedded as defaults and extracted to %ProgramData%\KLWinHealth\config\
         on first run, where they can be edited/updated without rebuilding. -->
    <EmbeddedResource Include="Config\*.json" LogicalName="KLWinHealth.Config.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
